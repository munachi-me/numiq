{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "numiq": [
        "./src/node.ts"
      ]
    }
  },
  "include": [
    "examples/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
